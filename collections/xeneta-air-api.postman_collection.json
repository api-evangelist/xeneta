          "id": "a42b457f-9561-4544-bd68-b4a56cbd9684",
          "name": "Get market rates",
          "request": {
            "name": "Get market rates",
            "description": {
              "content": "Returns air freight market rates within the specified parameters.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "air",
                "market-rates"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "origin",
                  "value": "PVG",
                  "description": "(Required) Defines the origin location of the requested market rate data. Can be either an IATA airport code or a region as defined in Xeneta's [geo-hierarchy](https://www.xeneta.com/hubfs/2025-air-geo/xeneta-air-geo.html). For example, `PVG` or `east_china_main`."
                },
                {
                  "disabled": false,
                  "key": "destination",
                  "value": "FRA",
                  "description": "(Required) Defines the destination location of the requested market rate data. Can be either an IATA airport code or a region as defined in Xeneta's [geo-hierarchy](https://www.xeneta.com/hubfs/2025-air-geo/xeneta-air-geo.html). For example, `FRA` or `north_europe_main`."
                },
                {
                  "disabled": false,
                  "key": "date_from",
                  "value": "2023-02-01",
                  "description": "(Required) Defines the start date of the date range for the requested market rates in the `YYYY-MM-DD` format. The total range cannot exceed 31 days."
                },
                {
                  "disabled": false,
                  "key": "date_to",
                  "value": "2023-02-05",
                  "description": "(Required) Defines the end date of the date range for the requested market rates in the `YYYY-MM-DD` format. The total range cannot exceed 31 days."
                },
                {
                  "disabled": false,
                  "key": "contract_length",
                  "value": "long",
                  "description": "(Required) Defines the type of contract for the requested market rate data. `long` is the only accepted value."
                },
                {
                  "disabled": false,
                  "key": "contracted_within",
                  "value": "all",
                  "description": "(Required) Defines the maximum age of the contracts to be included in the requested market rate data, relative to each day. Accepted values include `all` and `3months`."
                },
                {
                  "disabled": false,
                  "key": "weight_bracket",
                  "value": "greater_than_500kg",
                  "description": "(Required) Defines the weight category of the requested rate data. Accepted values are `less_than_45kg`, `greater_than_45kg`, `greater_than_200kg`, `greater_than_500kg`, and `greater_than_1000kg`."
                },
                {
                  "disabled": false,
                  "key": "service_level",
                  "value": "mid_tier",
                  "description": "(Required) Defines the service level of the requested rate data. Accepted values are `upper_tier`, `mid_tier`, `lower_tier`, `lower_and_mid_tier`, and `passive`."
                }
              ],
              "variable": []
            },
